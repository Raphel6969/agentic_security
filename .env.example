# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# Phase 4 — LLM-judge (Groq API)
GROQ_API_KEY=

# Phase 5 — Policy engine
POLICY_FILE_PATH=policy/policy.example.yaml

# Phase 6+ — Session/Audit Store (SQLite for local dev, Neon PostgreSQL for cloud)
# DATABASE_URL=sqlite:///./sentinel.db
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./sentinel.db

# Gmail client / Notification settings (Optional)
GMAIL_APP_PASSWORD=
GMAIL_USER=
DEPARTMENT_EMAILS={"SOC Operations":"soc@company.com","Security Engineering":"security@company.com","Incident Response":"ir@company.com"}

# Phase 10 — Auth Credentials (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 10 — Auth Credentials (GitHub OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Phase 10 — JWT Auth
JWT_SECRET=generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_AGENT_TOKEN_EXPIRE_HOURS=8

# Phase 10 — Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173
